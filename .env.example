# Environment Configuration Example
# Copy this file to .env before running the backend or frontend services.
# Do NOT commit actual secrets or credentials to source control.

# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# AI Provider Configuration (Optional for P0; core tabular generation works without AI)
# Used in P1 for natural language dataset prompting and schema understanding
GEMINI_API_KEYS=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# Optional comma-separated models; verify availability with your API key.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash
GEMINI_THINKING_LEVEL=low
# Per attempt, including the server deadline forwarded by the SDK.
AI_REQUEST_TIMEOUT_SECONDS=120
AI_TOTAL_TIMEOUT_SECONDS=180
AI_MAX_RETRIES=2

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
