# Environment Configuration Example
# Copy this file to .env before running the backend or frontend services.
# Do NOT commit actual secrets or credentials to source control.

# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# AI Provider Configuration (Optional for P0; core tabular generation works without AI)
# Used in P1 for natural language dataset prompting and schema understanding
GEMINI_API_KEYS=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
